# Model basename; loaded from ../models/ggml-$WHISPER_MODEL.bin (default: medium)
WHISPER_MODEL=

# Number of local whisper.cpp workers (default: num_cpus / 4)
WHISPER_PROCESSES=

# Optional: URL of a remote whisper server. If set, an extra WhisperX worker
# is started that POSTs audio to this URL alongside the local pool.
WHISPER_SERVER=

# Address to bind to (default: 127.0.0.1:3030)
LISTEN=

# Practice materials directory (default: ../assets)
ASSETS_DIR=

# Where per-session WAV/transcript/metadata files are written.
# If unset, recording is disabled entirely.
RECORDINGS_DIR=

# Built React SPA to serve (default: ../terplounge-fe/dist)
REACT_BUILD_DIR=../terplounge-fe/dist

RUST_LOG=
RUST_BACKTRACE=
